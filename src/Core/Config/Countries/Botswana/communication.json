{
  "sms_gateway": {
    "provider": "multi_network",
    "enabled": true
  },
  "telcos": {
    "cazacom": {
      "name": "Cazacom",
      "prefixes": ["70"],
      "sms_enabled": true,
      "api_key_env": "CAZACOM_API_KEY",
      "base_url": "https://cazacom-production.up.railway.app",
      "endpoint": "/api.php?path=sms/send"
    },
    "mascom": {
      "name": "Mascom",
      "prefixes": ["71", "72", "73", "74", "75"],
      "sms_enabled": true,
      "api_key_env": "MASCOM_API_KEY",
      "base_url": "https://mascom-api.com",
      "endpoint": "/sms/send"
    },
    "orange": {
      "name": "Orange",
      "prefixes": ["76", "77", "78"],
      "sms_enabled": true,
      "api_key_env": "ORANGE_API_KEY",
      "base_url": "https://orange-api.com",
      "endpoint": "/sms/send"
    }
  }
}
