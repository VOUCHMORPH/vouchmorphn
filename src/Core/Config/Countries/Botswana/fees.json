{
  "CASHOUT": {
    "description": "Cashout swap fee - client pays P10 upfront",

    "fee_components": {
      "F1": {
        "amount": 10.00
      },

      "F7": {
        "amount": 1.00
      }
    },

    "distribution": {

      "apply_after_fees": ["F7"],

      "base_distribution_amount": "F1 - F7",

      "description": "Distribution percentages are applied after deducting F7.",

      "split": {

        "platform_percent": 35,

        "source_institution_percent": 15,

        "destination_institution_percent": 50
      }
    },

    "destination_split": {

      "apply_to": "destination_institution_share",

      "generate_code_fee_percent": 10,

      "cashout_fee_percent": 90,

      "description": "Destination share is split into 10% generate code fee and 90% cashout completion fee."
    },

    "earnings_rules": {

      "generate_code_fee_earned_at": "code_generation",

      "cashout_fee_earned_at": "cashout_completion",

      "description": "Generate code fee is earned immediately. Cashout fee is earned only after successful cashout."
    },

    "retry_rules": {

      "fee_type": "F10",

      "amount": 0.45,

      "description": "Retries charge only the generate code fee."
    },

    "swap_on_swap": {

      "free_first": true,

      "client_pays": 0,

      "generate_code_fee_paid_by": "vouchmorph_from_platform_share",

      "cashout_fee_source": "unearned_cashout_fee_from_failed_attempt",

      "description": "First retry: VouchMorph pays the P0.45 generate code fee. The P4.05 cashout fee comes from the unearned cashout completion fee."
    },

    "example": {

      "client_pays": 10.00,

      "F7": 1.00,

      "distributable_amount": 9.00,

      "platform_share": 3.15,

      "source_share": 1.35,

      "destination_share": 4.50,

      "generate_code_fee": 0.45,

      "cashout_completion_fee": 4.05
    }
  },

  "DEPOSIT": {

    "description": "Deposit swap fee - client pays P6 upfront",

    "fee_components": {

      "F1": {
        "amount": 6.00
      },

      "F7": {
        "amount": 1.00
      }
    },

    "distribution": {

      "apply_after_fees": ["F7"],

      "base_distribution_amount": "F1 - F7",

      "description": "Distribution percentages are applied after deducting F7.",

      "split": {

        "platform_percent": 35,

        "source_institution_percent": 15,

        "destination_institution_percent": 50
      }
    },

    "example": {

      "client_pays": 6.00,

      "F7": 1.00,

      "distributable_amount": 5.00,

      "platform_share": 1.75,

      "source_share": 0.75,

      "destination_share": 2.50
    }
  },

  "CARD_LOAD": {

    "description": "Card load fee - follows deposit structure",

    "fee_components": {

      "F1": {
        "amount": 6.00
      },

      "F7": {
        "amount": 1.00
      }
    },

    "distribution": {

      "apply_after_fees": ["F7"],

      "base_distribution_amount": "F1 - F7",

      "split": {

        "platform_percent": 35,

        "source_institution_percent": 15,

        "destination_institution_percent": 50
      }
    }
  }
}
