{
  "CASHOUT": {
    "description": "Cashout swap fee - client pays P10 upfront",
    "fee_components": {
      "F1": {
        "amount": 10.00,
        "description": "Total customer upfront fee"
      },
      "F7": {
        "amount": 1.00,
        "description": "Swap levy (government regulatory fee)"
      }
    },
    "distribution": {
      "apply_after_fees": ["F7"],
      "base_distribution_amount": "F1 - F7",
      "description": "Distribution percentages applied after deducting F7 (swap levy)",
      "split": {
        "platform_percent": 35,
        "platform_owner": "VOUCHMORPH",
        "source_institution_percent": 15,
        "source_owner": "SOURCE_INSTITUTION",
        "destination_institution_percent": 50,
        "destination_owner": "DESTINATION_INSTITUTION"
      }
    },
    "destination_split": {
      "apply_to": "destination_institution_share",
      "description": "Destination share is split into generate code fee (earned immediately) and cashout completion fee (earned on success)",
      "generate_code_fee_percent": 10,
      "cashout_fee_percent": 90,
      "generate_code_earned_at": "code_generation",
      "cashout_earned_at": "cashout_completion"
    },
    "earnings_rules": {
      "generate_code_fee_earned_at": "code_generation",
      "cashout_fee_earned_at": "cashout_completion",
      "description": "Generate code fee is earned immediately. Cashout fee is earned only after successful cashout."
    },
    "retry_rules": {
      "fee_type": "F10",
      "amount": 0.45,
      "description": "Retries charge only the generate code fee"
    },
    "swap_on_swap": {
      "free_first": true,
      "client_pays": 0,
      "generate_code_fee_paid_by": "vouchmorph_from_platform_share",
      "cashout_fee_source": "unearned_cashout_fee_from_failed_attempt",
      "description": "First retry: VouchMorph pays the generate code fee from platform share"
    },
    "example_calculation": {
      "client_pays": 10.00,
      "F7_levy": 1.00,
      "distributable_pool": 9.00,
      "platform_share_35%": 3.15,
      "source_share_15%": 1.35,
      "destination_share_50%": 4.50,
      "generate_code_fee_10%": 0.45,
      "cashout_completion_fee_90%": 4.05
    }
  },
