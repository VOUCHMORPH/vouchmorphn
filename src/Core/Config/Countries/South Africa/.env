# Region & Country
VM_COUNTRY=ZA
VM_TZ=Africa/Johannesburg

# App Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://vouchmorphn-production-af4f.up.railway.app

# PostgreSQL – Swap System (ZA) - Railway
PG_HOST=interchange.proxy.rlwy.net
PG_PORT=52371
PG_USER=postgres
PG_PASS=JcEMxRQuEImysxrAgeJPgJDXYfsnUxSB
PG_NAME=railway

PG_DB_PARTNER_1=swap_system_partner1
PG_DB_PARTNER_2=swap_system_partner2
PG_DB_PARTNER_3=swap_system_partner3

# API Credentials
API_KEY_SYSTEM=sys_key_2026_sandbox_001
API_KEY_PARTNER_1=partner1_key_2026_sandbox
API_KEY_PARTNER_2=partner2_key_2026_sandbox
API_KEY_PARTNER_3=partner3_key_2026_sandbox
API_KEY_PARTNER_4=partner4_key_2026_sandbox
API_KEY_ZURUBANK=918446212c28e04075df3f4bfa4ae3971091379af233ab69c7ec7e5c2d5b17d9

# Bank Base URLs (Only ZURUBANK-SOUTHAFRICA)
ZURUBANK_BASE_URL=https://zurubank-southafrica-production.up.railway.app/Backend

# Encryption (AES-256-GCM) - Exactly 32 chars
APP_ENCRYPTION_KEY=ThisIsA32CharKeyForAES256GCM2026!

# Mojaloop Integration
MOJALOOP_ENDPOINT=https://vouchmorphn-production.up.railway.app
MOJALOOP_CALLBACK_URL=https://vouchmorphn-production.up.railway.app/mojaloop/callback
MOJALOOP_DFSP_ID=VOUCHMORPHN_ZA

# Participant Configuration
PARTICIPANTS=ZURUBANK
DEFAULT_CURRENCY=ZAR

# Logging
LOG_LEVEL=debug
LOG_PATH=/app/storage/logs
LOG_FILE=swap_audit.log

# Regulatory Reporting (SARB - South African Reserve Bank)
REGULATORY_REPORTING_ENABLED=true
REGULATORY_ENDPOINT=https://vouchmorphn-production-af4f.up.railway.app/api/regulatory/report
REGULATORY_SCHEME=ZA_NPS
REGULATORY_CODE_SYSTEM=SAP

# SCA / OTP Configuration (FICA compliant)
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
SCA_REQUIRED_FOR_AMOUNT=5000

# Settlement Configuration
SETTLEMENT_BATCH_SIZE=100
SETTLEMENT_INTERVAL_MINUTES=15
LIQUIDITY_THRESHOLD=1000000

# Cache/Redis (Optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
